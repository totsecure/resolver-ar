/* renaper.js — cliente del servicio RenaperService.
 *
 * OJO: renaperservice.onrender.com es un SIMULADOR (UTN-FRT). Solo tiene
 * hardcodeados los DNIs 30123456 (F) y 33456789 (M). No es el RENAPER real.
 * Se usa como contrato/fallback de prueba hasta que el CNE reabra.
 *
 * Contrato:
 *   GET {BASE}/api/personas/{dni}?genero={M|F|X}
 *   header: X-API-Key: <RENAPER_API_KEY>
 *
 * Respuesta (campos exactos del servicio):
 *   dni, nombre, apellido, fechaNacimiento (YYYY-MM-DD), lugarNacimiento, sexo,
 *   nacionalidad, estadoCivil,
 *   domicilio: { calle, numero, piso, departamento, codigoPostal, localidad, provincia }
 *
 * No devuelve nroTramite ni cuil: se dejan AUSENTE (null), nunca se inventan.
 *
 * Genero: se deriva del prefijo del CUIT del padron (20/23/24 => M, 27 => F).
 * Si el DNI no esta en el padron o la consulta da 404, se reintenta M, F, X.
 * El genero que funciono se guarda en la columna `genero` de la tabla renaper.
 */

import fs from 'node:fs';
import path from 'node:path';
import { DatabaseSync } from 'node:sqlite';

export const BASE = process.env.RENAPER_BASE || 'https://apirnpr.onrender.com';
export const TTL_DIAS = Number(process.env.RENAPER_TTL_DIAS || 365);

const API_KEY_DEFAULT = 'sk_renaper_inventario_2025_secret_key';
const API_KEY = process.env.RENAPER_API_KEY || API_KEY_DEFAULT;
const CAMINO = process.env.RENAPER_PATH || '/renaper/{dni}/{genero}';
const TIMEOUT_MS = Number(process.env.RENAPER_TIMEOUT_MS || 60000);

const RAIZ = path.join(import.meta.dirname, '..');
const RUTA_DB = process.env.RESOLVER_DB || path.join(RAIZ, 'datos', 'padron.db');
const RUTA_LOG = path.join(RAIZ, 'datos', 'renaper.log');

const ORDEN_CUIT = "CASE substr(cuit,1,2) WHEN '20' THEN 0 WHEN '27' THEN 1 WHEN '23' THEN 2 WHEN '24' THEN 3 ELSE 4 END, cuit";

let db = null;

function abrir() {
  if (db) return db;
  fs.mkdirSync(path.dirname(RUTA_DB), { recursive: true });
  db = new DatabaseSync(RUTA_DB);
  db.exec('PRAGMA busy_timeout = 5000');
  db.exec(`CREATE TABLE IF NOT EXISTS renaper (
    dni           TEXT PRIMARY KEY,
    fechaNac      TEXT,
    nroTramite    TEXT,
    direccion     TEXT,
    ciudad        TEXT,
    provincia     TEXT,
    cpostal       TEXT,
    cuilRenaper   TEXT,
    fuente        TEXT,
    capturado     TEXT,
    ttl_dias      INTEGER,
    crudo         TEXT,
    genero        TEXT
  )`);
  /* Tabla vieja sin genero: se agrega sin perder datos. */
  try { db.exec('ALTER TABLE renaper ADD COLUMN genero TEXT'); } catch (_) {}
  db.exec(`CREATE TABLE IF NOT EXISTS renaper_intentos (
    id      INTEGER PRIMARY KEY AUTOINCREMENT,
    dni     TEXT,
    ts      TEXT,
    http    INTEGER,
    motivo  TEXT
  )`);
  return db;
}

/** Crea/actualiza las tablas. Idempotente. */
export function asegurar() {
  try {
    abrir();
    return true;
  } catch (_) {
    return false;
  }
}

export function normalizarDni(dni) {
  const d = String(dni ?? '').replace(/\D/g, '');
  if (!d) return null;
  if (d.length === 11) return d.slice(2, 10);
  return d.length <= 8 ? d.padStart(8, '0') : d.slice(-8);
}

export function normalizarGenero(genero) {
  const g = String(genero ?? '').trim().toUpperCase();
  if (g === 'M' || g === 'F' || g === 'X') return g;
  if (/^(MASCULINO|MALE|HOMBRE)$/.test(g)) return 'M';
  if (/^(FEMENINO|FEMALE|MUJER)$/.test(g)) return 'F';
  return 'X';
}

/** Genero derivado del prefijo del CUIT del padron: 20/23/24 => M, 27 => F. */
export function generoPorCuit(dni) {
  const d = normalizarDni(dni);
  if (!d) return null;
  try {
    const fila = abrir()
      .prepare('SELECT cuit FROM personas WHERE dni = ? ORDER BY ' + ORDEN_CUIT + ' LIMIT 1')
      .get(d);
    if (!fila) return null;
    const prefijo = String(fila.cuit || '').slice(0, 2);
    if (prefijo === '27') return 'F';
    if (prefijo === '20' || prefijo === '23' || prefijo === '24') return 'M';
    return null;
  } catch (_) {
    return null;
  }
}

function registrarIntento(dni, info = {}) {
  const d = normalizarDni(dni);
  const ts = new Date().toISOString();
  const http = Number.isFinite(Number(info.http)) && Number(info.http) > 0 ? Number(info.http) : null;
  const motivo = info.motivo == null ? null : String(info.motivo).slice(0, 300);
  try {
    fs.appendFileSync(RUTA_LOG, JSON.stringify({ ts, dni: d || null, http, motivo }) + '\n');
  } catch (_) {}
  if (!d) return;
  try {
    abrir().prepare('INSERT INTO renaper_intentos (dni, ts, http, motivo) VALUES (?,?,?,?)').run(d, ts, http, motivo);
  } catch (_) {}
}

/** Lee la cache. Devuelve la fila + {vencido} o null. */
export function leer(dni) {
  const d = normalizarDni(dni);
  if (!d) return null;
  try {
    const fila = abrir().prepare('SELECT * FROM renaper WHERE dni = ?').get(d);
    if (!fila) return null;
    const ttl = Number(fila.ttl_dias ?? TTL_DIAS);
    const capturado = Date.parse(fila.capturado);
    const edadDias = Number.isFinite(capturado) ? (Date.now() - capturado) / 86400000 : Infinity;
    /* La tabla no tiene columnas de nombre: se recuperan del crudo. */
    let apellido = null;
    let nombres = null;
    if (fila.crudo) {
      try {
        const j = JSON.parse(fila.crudo);
        apellido = texto(j.apellido);
        nombres = texto(j.nombres ?? j.nombre);
      } catch (_) {}
    }
    return {
      ...fila,
      apellido,
      nombres,
      genero: fila.genero ?? null,
      fuente: fila.fuente || 'REAL_RENAPER',
      vencido: !(edadDias <= ttl),
    };
  } catch (_) {
    return null;
  }
}

/** Guarda/actualiza una fila de cache. */
export function guardar(dni, datos = {}, meta = {}) {
  const d = normalizarDni(dni);
  if (!d) return null;
  const crudo = meta.crudo == null
    ? null
    : (typeof meta.crudo === 'string' ? meta.crudo : JSON.stringify(meta.crudo)).slice(0, 8000);
  const g = String(meta.genero ?? datos.genero ?? '').trim().toUpperCase();
  const genero = (g === 'M' || g === 'F' || g === 'X') ? g : null;
  const fuente = meta.fuente === 'AUSENTE' ? 'AUSENTE' : 'REAL_RENAPER';
  const ttl = Number(meta.ttlDias) > 0 ? Number(meta.ttlDias) : TTL_DIAS;
  try {
    abrir().prepare(`INSERT INTO renaper
      (dni, fechaNac, nroTramite, direccion, ciudad, provincia, cpostal, cuilRenaper,
       fuente, capturado, ttl_dias, crudo, genero)
      VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)
      ON CONFLICT(dni) DO UPDATE SET
        fechaNac=excluded.fechaNac, nroTramite=excluded.nroTramite, direccion=excluded.direccion,
        ciudad=excluded.ciudad, provincia=excluded.provincia, cpostal=excluded.cpostal,
        cuilRenaper=excluded.cuilRenaper, fuente=excluded.fuente,
        capturado=excluded.capturado, ttl_dias=excluded.ttl_dias, crudo=excluded.crudo,
        genero=excluded.genero`)
      .run(d, datos.fechaNac ?? null, datos.nroTramite ?? null, datos.direccion ?? null,
        datos.ciudad ?? null, datos.provincia ?? null, datos.cpostal ?? null,
        datos.cuilRenaper ?? null, fuente, new Date().toISOString(), ttl, crudo, genero);
  } catch (_) {
    return null;
  }
  return leer(d);
}

/* ---------------------------------------------------------------------------
 * interpretar(): PURA. Sin red, sin DB. Mapea el JSON EXACTO del servicio.
 * ------------------------------------------------------------------------- */
function texto(v) {
  if (v === null || v === undefined) return null;
  const s = String(v).trim();
  return s === '' ? null : s;
}

function dosDigitos(n) {
  return String(n).padStart(2, '0');
}

/** Normaliza fecha de nacimiento a dd/mm/aaaa. No inventa formatos. */
export function normalizarFecha(v) {
  const s = texto(v);
  if (!s) return null;
  let m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return `${m[3]}/${m[2]}/${m[1]}`;
  m = s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/);
  if (m) return `${dosDigitos(m[1])}/${dosDigitos(m[2])}/${m[3]}`;
  return s;
}

function componerDireccion(dom) {
  if (typeof dom === 'string') return texto(dom);
  if (!dom || typeof dom !== 'object') return null;
  const calle = texto(dom.calle);
  const numero = texto(dom.numero);
  if (calle && numero) return `${calle} ${numero}`;
  return calle || numero || null;
}

export function interpretar(payload) {
  let j = payload;
  if (typeof j === 'string') {
    try { j = JSON.parse(j); } catch (_) { j = null; }
  }
  if (Array.isArray(j)) j = j[0] ?? null;

  const vacio = {
    fuente: 'AUSENTE',
    motivo: 'respuesta vacia o invalida',
    dni: null,
    apellido: null,
    nombres: null,
    fechaNac: null,
    nroTramite: null,
    direccion: null,
    calle: null,
    numeroCalle: null,
    ciudad: null,
    provincia: null,
    cpostal: null,
    cuilRenaper: null,
    sexo: null,
    genero: null,
    codigoError: null,
  };
  if (!j || typeof j !== 'object') return vacio;

  /* Formato nuevo: la data viene envuelta en respuesta. */
  if (j.respuesta && typeof j.respuesta === 'object') {
    const env = j;
    j = Object.assign({}, env.respuesta);
    if (j.error === undefined) j.error = env.error;
    if (j.mensaje === undefined) j.mensaje = env.mensaje;
  }

  const cod = Number(j.codigoError);
  const errorFlag = j.error === true
    || (typeof j.error === 'string' && j.error !== '' && j.error.toLowerCase() !== 'false');
  /* descripcionError viene SIEMPRE ('DNI/PAS Firmado'): solo es error si codigoError != 200. */
  const motivoError = (Number.isFinite(cod) && cod !== 200 ? (texto(j.descripcionError) || 'codigoError ' + cod) : null)
    || (errorFlag ? (texto(j.mensaje) || texto(j.message) || 'error del servicio') : null);
  if (motivoError) return { ...vacio, motivo: motivoError };

  const dom = (j.domicilio && typeof j.domicilio === 'object') ? j.domicilio : null;
  const calle = (dom ? texto(dom.calle) : null) || texto(j.calle);
  const numero = (dom ? texto(dom.numero) : null) || texto(j.numeroCalle);

  const out = {
    fuente: 'REAL_RENAPER',
    motivo: null,
    dni: normalizarDni(texto(j.dni)) || null,
    apellido: texto(j.apellido),
    nombres: texto(j.nombre ?? j.nombres),
    fechaNac: normalizarFecha(j.fechaNacimiento),
    /* El servicio no devuelve nroTramite: queda AUSENTE. */
    nroTramite: texto(j.nroTramite) || (Number(j.idTramitePrincipal) > 0 ? String(j.idTramitePrincipal) : null),
    direccion: componerDireccion(dom) || (calle ? [calle, numero].filter(Boolean).join(' ') : null),
    calle,
    numeroCalle: numero,
    ciudad: (dom ? texto(dom.localidad) : null) || texto(j.ciudad) || texto(j.municipio),
    provincia: (dom ? texto(dom.provincia) : null) || texto(j.provincia),
    cpostal: (dom ? texto(dom.codigoPostal) : null) || texto(j.cpostal),
    cuilRenaper: texto(j.cuil) || null,
    sexo: texto(j.sexo),
    genero: null,
    codigoError: null,
  };

  const util = ['apellido', 'nombres', 'fechaNac', 'nroTramite', 'direccion', 'ciudad', 'provincia', 'cpostal'];
  if (!util.some((k) => out[k] !== null)) return { ...vacio, motivo: 'respuesta sin datos utiles' };
  return out;
}

/* --------------------------------------------------------------------------- */
async function traer(url, init = {}, timeoutMs = TIMEOUT_MS) {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const res = await fetch(url, { ...init, signal: ctrl.signal });
    let cuerpo = '';
    try { cuerpo = await res.text(); } catch (_) {}
    return { ok: res.ok, http: res.status, cuerpo };
  } catch (e) {
    return {
      ok: false, http: 0, cuerpo: '',
      motivo: e?.name === 'AbortError' ? `timeout ${timeoutMs}ms` : String(e?.message || e),
    };
  } finally {
    clearTimeout(t);
  }
}

/* Un solo GET para un genero concreto. */
async function pedir(dni, genero, opts = {}) {
  const camino = CAMINO
    .replaceAll('{dni}', encodeURIComponent(dni))
    .replaceAll('{genero}', encodeURIComponent(genero));
  const url = `${BASE.replace(/\/+$/, '')}${camino.startsWith('/') ? '' : '/'}${camino}`;

  const headers = { accept: 'application/json' };
  if (API_KEY) headers['x-api-key'] = API_KEY;
  const usuario = process.env.RENAPER_USER;
  const clave = process.env.RENAPER_PASS;
  if (usuario && clave) {
    headers.authorization = 'Basic ' + Buffer.from(`${usuario}:${clave}`).toString('base64');
  }

  const r = await traer(url, { headers }, Number(opts.timeoutMs || TIMEOUT_MS));

  let json = null;
  if (r.cuerpo) { try { json = JSON.parse(r.cuerpo); } catch (_) {} }

  if (!r.ok) {
    const motivo = r.motivo
      || (json && (texto(json.error) || texto(json.message) || texto(json.mensaje)))
      || `HTTP ${r.http}`;
    registrarIntento(dni, { http: r.http, motivo: `genero=${genero} ${motivo}` });
    return { ok: false, fuente: 'AUSENTE', http: r.http, genero, motivo, crudo: r.cuerpo.slice(0, 400) };
  }

  if (!json) {
    registrarIntento(dni, { http: r.http, motivo: `genero=${genero} respuesta no-JSON` });
    return { ok: false, fuente: 'AUSENTE', http: r.http, genero, motivo: 'respuesta no-JSON', crudo: r.cuerpo.slice(0, 400) };
  }

  const datos = interpretar(json);
  if (datos.fuente !== 'REAL_RENAPER') {
    registrarIntento(dni, { http: r.http, motivo: `genero=${genero} ${datos.motivo || 'sin datos'}` });
    return { ok: false, fuente: 'AUSENTE', http: r.http, genero, motivo: datos.motivo || 'sin datos', crudo: json };
  }

  registrarIntento(dni, { http: r.http, motivo: `ok genero=${genero}` });
  return { ok: true, fuente: 'REAL_RENAPER', http: r.http, genero, datos: { ...datos, genero }, crudo: json };
}

/**
 * Consulta remota con fallback de genero:
 *   1) genero explicito (opts.genero), si vino
 *   2) genero derivado del CUIT del padron
 *   3) M, F, X
 * Reintenta solo ante 404/400. Nunca lanza.
 */
export async function consultarRemoto(dni, opts = {}) {
  const d = normalizarDni(dni);
  if (!d) return { ok: false, fuente: 'AUSENTE', http: null, motivo: 'dni invalido' };

  const secuencia = [];
  if (opts.genero) secuencia.push(normalizarGenero(opts.genero));
  const derivado = generoPorCuit(d);
  if (derivado) secuencia.push(derivado);
  for (const g of ['M', 'F', 'X']) secuencia.push(g);

  const vistos = [...new Set(secuencia)];
  let ultimo = null;

  for (const genero of vistos) {
    const r = await pedir(d, genero, opts);
    if (r.ok) return r;
    ultimo = r;
    if (r.http === 404 || r.http === 400) continue;
    return r; // 401 / 5xx / timeout: no tiene sentido probar otro genero
  }

  return ultimo || { ok: false, fuente: 'AUSENTE', http: 404, motivo: 'no encontrado en ningun genero', genero: null };
}

function ausente(motivo, http = null, enCache = null) {
  return {
    fuente: 'AUSENTE',
    origen: 'SIN_DATOS',
    motivo: motivo || 'sin dato',
    http,
    fechaNac: enCache?.fechaNac ?? null,
    nroTramite: enCache?.nroTramite ?? null,
    direccion: enCache?.direccion ?? null,
    ciudad: enCache?.ciudad ?? null,
    provincia: enCache?.provincia ?? null,
    cpostal: enCache?.cpostal ?? null,
    genero: enCache?.genero ?? null,
    vencido: enCache ? Boolean(enCache.vencido) : null,
  };
}

/**
 * Cache -> red. Por defecto SOLO cache: la red se habilita con opts.red === true
 * (o opts.sinRed === false). Nunca lanza.
 */
export async function obtener(dni, opts = {}) {
  const d = normalizarDni(dni);
  if (!d) return ausente('dni invalido');

  const enCache = leer(d);
  if (!opts.forzar && enCache && !enCache.vencido) {
    if (enCache.fuente === 'AUSENTE') {
      return { ...ausente('404 cacheado (TTL 30d)', 404, enCache), origen: 'CACHE' };
    }
    return { ...enCache, fuente: 'REAL_RENAPER', origen: 'CACHE' };
  }

  const red = opts.red === true || opts.sinRed === false;
  if (!red) return ausente(enCache ? 'cache vencido, sin red' : 'sin cache y sin red', null, enCache);

  const r = await consultarRemoto(d, opts);
  if (r.ok) {
    const guardado = guardar(d, r.datos, { crudo: r.crudo, genero: r.genero });
    return guardado
      ? { ...guardado, ...r.datos, fuente: 'REAL_RENAPER', origen: 'REMOTO', genero: r.genero }
      : { ...r.datos, fuente: 'REAL_RENAPER', origen: 'REMOTO', genero: r.genero };
  }
  /* Cache negativo: un 404 no se vuelve a consultar por 30 dias. */
  if (r.http === 404) {
    try {
      guardar(d, { fuente: 'AUSENTE' }, {
        crudo: { error: '404', genero: null },
        ttlDias: Number(process.env.RENAPER_TTL_AUSENTE_DIAS || 2),
        fuente: 'AUSENTE',
        genero: null,
      });
    } catch (_) {}
  }
  return ausente(r.motivo, r.http, enCache);
}

/** Sync: SOLO cache (para red usar obtener()). */
export function obtenerSync(dni, opts = {}) {
  const d = normalizarDni(dni);
  if (!d) return ausente('dni invalido');
  let enCache = null;
  try { enCache = leer(d); } catch (_) {}
  if (enCache && !enCache.vencido) return { ...enCache, fuente: 'REAL_RENAPER', origen: 'CACHE' };
  return ausente(
    opts.red ? 'modo sync: solo cache; usar obtener() para consultar la red' : (enCache ? 'cache vencido, sin red' : 'sin cache, sin red'),
    null,
    enCache
  );
}

/** Estado de la cache y de los intentos. Nunca lanza. */
export function stats() {
  const base = {
    tabla: 'renaper',
    cacheados: 0,
    conFechaNac: 0,
    conTramite: 0,
    conDireccion: 0,
    conGenero: 0,
    intentos: 0,
    ultimoIntento: null,
    ultimos: [],
    ttlDias: TTL_DIAS,
    base: BASE,
    error: null,
  };
  try {
    const a = abrir();
    base.cacheados = a.prepare('SELECT COUNT(*) n FROM renaper').get().n;
    base.conFechaNac = a.prepare('SELECT COUNT(*) n FROM renaper WHERE fechaNac IS NOT NULL').get().n;
    base.conTramite = a.prepare('SELECT COUNT(*) n FROM renaper WHERE nroTramite IS NOT NULL').get().n;
    base.conDireccion = a.prepare('SELECT COUNT(*) n FROM renaper WHERE direccion IS NOT NULL').get().n;
    base.conGenero = a.prepare('SELECT COUNT(*) n FROM renaper WHERE genero IS NOT NULL').get().n;
    base.intentos = a.prepare('SELECT COUNT(*) n FROM renaper_intentos').get().n;
    base.ultimos = a.prepare('SELECT ts, dni, http, motivo FROM renaper_intentos ORDER BY id DESC LIMIT 5').all();
    base.ultimoIntento = base.ultimos[0] ?? null;
  } catch (e) {
    base.error = String(e?.message || e);
  }
  return base;
}
