[Unit]
Description=resolver-ar (API de consulta de padron)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=resolver
Group=resolver
WorkingDirectory=/opt/resolver
EnvironmentFile=/etc/resolver.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
